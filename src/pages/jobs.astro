---
/**
 * Jobs Page — /jobs/
 *
 * Careers hub for Painless Removals, targeting "removal jobs Bristol" searches.
 * The hero surfaces the live vacancies immediately (CRM-driven); each links to
 * its own /jobs/[slug]/ detail page which carries the JobPosting structured
 * data. The open-application form stays here for people the current roles
 * don't fit.
 */

import Layout from '@/layouts/Layout.astro';
import OptimizedPicture from '@/components/OptimizedPicture.astro';
import ApplicationForm from '@/components/careers/ApplicationForm.astro';
import { siteConfig } from '@/config/site.config';
import { ref, breadcrumbs } from '@/utils/schema';
import { fetchPostings } from '@/lib/careers/crm';
import { EMPLOYMENT_LABELS, FALLBACK_POSTINGS, withFallbackMeta } from '@/lib/careers/fallback';

export const prerender = false;

// Page metadata
const pageTitle = "Removal Jobs in Bristol – Join Painless Removals";
const pageDescription = 'Removal jobs in Bristol with Painless Removals — a family-run removals company since 1978. See our current driver, porter and office vacancies and apply online today.';

// Current roles — the CRM publishes them (edit a vacancy without a deploy); if it is
// unreachable we render the long-standing roles instead. In fallback mode the
// postings carry no id, so the application takes the email-only path.
const roles = withFallbackMeta((await fetchPostings()) ?? FALLBACK_POSTINGS);

// The page went from prerendered to on-demand so vacancy edits go live without a deploy.
// `s-maxage` lets the edge serve the same HTML for five minutes — matching the CRM's own
// cache TTL — so the common case costs no more than the static page did.
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=300');

// Benefits — each card carries a real crew photo instead of a generic icon.
const benefits = [
  {
    img: 'areas/chepstow-team',
    alt: 'The Painless Removals crew standing together by their van',
    title: 'Family-Run Team',
    description: 'We\'re a tight-knit crew, not a faceless corporation. Everyone knows your name and has your back.',
  },
  {
    img: 'areas/brislington-property-removal-team',
    alt: 'Painless Removals team members on a removal job in Bristol',
    title: 'Real Living Wage',
    description: 'We\'re an accredited Living Wage Employer. Fair pay that reflects your hard work, plus tips on top.',
  },
  {
    img: 'areas/clevedon-removal-team-working',
    alt: 'Painless Removals crew working together on a move',
    title: 'Respect & a Chance to Grow',
    description: 'No experience needed — we\'re happy to train you. You\'ll join a genuinely friendly crew that feels more like a circle of mates than a corporate job, with a clear route up to team leader.',
  },
  {
    img: 'areas/thornbury-house-move-team',
    alt: 'Painless Removals team on a house move',
    title: 'No Two Days the Same',
    description: 'Different homes, different people, different challenges every day. If you hate being stuck behind a desk, you\'ll love it.',
  },
];

// The faces a candidate would actually work with — same photo set as /about,
// compact grid here with a link through to the full bios.
const teamMembers = [
  { img: 'about/team/Jay-Newton', name: 'Jay Newton', role: 'Director' },
  { img: 'about/team/Tom', name: 'Tom', role: 'Customer Relationships' },
  { img: 'about/team/Tamara', name: 'Tamara', role: 'Packing Team Lead' },
  { img: 'about/team/Pete', name: 'Pete', role: 'Removal Team Leader' },
  { img: 'about/team/Mike', name: 'Mike', role: 'Removal Team Leader' },
  { img: 'about/team/Laszlo', name: 'László', role: 'Marketing' },
  { img: 'about/team/Richard', name: 'Richard', role: 'Business Development' },
];

// Company values
const values = [
  { title: 'Respect', description: 'We treat every customer\'s home like our own. Their belongings matter to us.' },
  { title: 'Reliability', description: 'We turn up on time, every time. Our customers depend on us and we don\'t let them down.' },
  { title: 'Teamwork', description: 'A move goes smoothly when the crew works together. We look out for each other.' },
  { title: 'Pride', description: 'We take pride in doing a proper job. No shortcuts, no cutting corners.' },
];

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": `${siteConfig.brand.domain}/jobs/`,
    "publisher": ref.business(),
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Current removal job vacancies in Bristol",
    "itemListElement": roles.map((role, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": role.title,
      "url": `${siteConfig.brand.domain}/jobs/${role.slug}/`,
    })),
  },
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: "Jobs" },
  ]),
];
---

<Layout title={pageTitle} description={pageDescription} schema={pageSchema}>

  <!-- ============================================
       HERO – Removal Jobs in Bristol + live vacancies
  ============================================ -->
  <section class="gradient-hero py-6 lg:py-8">
    <div class="container-wide">
      {/* Split hero, built to fit above the fold on desktop: LEFT column holds
          the copy AND the two vacancy cards, RIGHT column is just the photo
          (natural aspect ratio, nobody cropped). Paddings and type sizes are
          deliberately tight — resist the urge to air it back out. */}
      <div class="grid lg:grid-cols-[1.2fr_1fr] gap-8 items-center">
        <div class="text-center lg:text-left">
          <p class="text-primary-600 text-sm font-semibold uppercase tracking-wide mb-2">
            Careers at Painless Removals
          </p>
          <h1 class="text-3xl lg:text-4xl xl:text-5xl font-bold mb-3">
            Removal Jobs in Bristol
          </h1>
          <p class="text-base lg:text-lg text-warm-gray max-w-2xl mx-auto lg:mx-0 leading-relaxed mb-6">
            We've been moving Bristol families since 1978. If you're hard-working, reliable, and
            like the idea of a job where no two days are the same — we'd love to hear from you.
          </p>

          {/* The vacancies are the first thing a job-seeker sees — each card goes
              straight through to its own page with the full description and form. */}
          <div class="grid sm:grid-cols-2 gap-4 text-left">
            {roles.map((role) => (
              <a href={`/jobs/${role.slug}/`}
                class="group bg-white rounded-xl p-5 shadow-sm border border-gray-100 no-underline hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col">
                <span class="inline-block bg-primary-100 text-primary-600 text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full w-fit mb-2.5">
                  {role.typeLabel ?? EMPLOYMENT_LABELS[role.employmentType]}
                </span>
                <h2 class="text-lg font-bold text-primary-600 mb-1.5 group-hover:text-secondary-500 transition-colors">{role.title}</h2>
                <p class="text-warm-gray text-sm leading-relaxed mb-3 line-clamp-3">{role.description.split('\n')[0].trim()}</p>
                <span class="mt-auto inline-flex items-center gap-1 text-secondary-500 font-semibold text-sm group-hover:gap-2 transition-all">
                  View role &amp; apply <span aria-hidden="true">&rarr;</span>
                </span>
              </a>
            ))}
          </div>

          <p class="text-warm-gray text-sm mt-4">
            Nothing that fits? <a href="#application-form" class="text-primary-600 font-semibold underline hover:text-secondary-500">Send us an open application</a> — we're always looking for good people.
          </p>
        </div>

        <div class="max-w-[400px] mx-auto w-full">
          <OptimizedPicture
            name="about/christmas-party"
            pattern="THIRD"
            alt="The Painless Removals team together at a team dinner"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-auto rounded-2xl shadow-lg"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       MEET THE TEAM – straight below the hero
  ============================================ -->
  <section class="section bg-white">
    <div class="container-wide">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold mb-4">The Team You'd Be Joining</h2>
        <p class="text-warm-gray text-lg max-w-2xl mx-auto">
          Real people, not a faceless agency. These are the faces you'll see at our Filton
          warehouse every morning — and out on removals across Bristol every day.
        </p>
      </div>

      <!-- Portraits -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-4 sm:gap-5 mb-6 max-w-5xl mx-auto">
        {teamMembers.map((member) => (
          <div class="text-center">
            <div class="aspect-square rounded-xl overflow-hidden shadow-sm border border-gray-100 mb-3 group">
              <OptimizedPicture
                name={member.img}
                pattern="SIXTH"
                alt={`${member.name}, ${member.role} at Painless Removals`}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <p class="font-bold text-primary-600 text-sm leading-tight">{member.name}</p>
            <p class="text-warm-gray text-xs mt-0.5">{member.role}</p>
          </div>
        ))}
      </div>

      <p class="text-center">
        <a href="/about/" class="inline-flex items-center gap-1 text-primary-600 font-semibold text-sm no-underline hover:text-secondary-500 hover:gap-2 transition-all">
          Read everyone's full story on our About page <span aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ============================================
       WHY WORK WITH US – photo cards
  ============================================ -->
  <section class="section bg-cream">
    <div class="container-wide">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold mb-4">Why Work With Us</h2>
        <p class="text-warm-gray text-lg max-w-2xl mx-auto">
          We're not just a removals company — we're a team that genuinely enjoys what we do.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {benefits.map((benefit) => (
          <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col group">
            <div class="aspect-[4/3] overflow-hidden">
              <OptimizedPicture
                name={benefit.img}
                pattern="QUARTER"
                alt={benefit.alt}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-5 flex flex-col flex-1">
              <h3 class="text-lg font-semibold text-primary-600 mb-2">{benefit.title}</h3>
              <p class="text-warm-gray text-sm leading-relaxed">{benefit.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       LIFE AT PAINLESS – candid photos
  ============================================ -->
  <section class="section bg-white">
    <div class="container-wide">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold mb-4">Life at Painless</h2>
        <p class="text-warm-gray text-lg max-w-2xl mx-auto">
          From our Filton warehouse to long-distance moves past the Shard — a few snapshots
          of what the everyday actually looks like.
        </p>
      </div>

      {/* CSS-columns masonry: every photo keeps its natural aspect ratio, so
          nobody gets cropped out — the browser balances the column heights. */}
      <div class="columns-1 sm:columns-2 gap-4 sm:gap-5 max-w-5xl mx-auto">
        <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100 mb-4 sm:mb-5 break-inside-avoid">
          <OptimizedPicture
            name="homepage/painless-removals-team"
            pattern="HALF"
            alt="The Painless Removals crew with our vans in Bristol"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </div>
        <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100 mb-4 sm:mb-5 break-inside-avoid">
          <OptimizedPicture
            name="office-removals/office-desk-reassembly-fixings-bristol"
            pattern="HALF"
            alt="A Painless Removals team member reassembling an office desk in Bristol"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </div>
        <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100 mb-4 sm:mb-5 break-inside-avoid">
          <OptimizedPicture
            name="home-removals/Bristol-home-removals-service-1"
            pattern="HALF"
            alt="Painless Removals crew carrying out a home removal in Bristol"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </div>
        <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100 mb-4 sm:mb-5 break-inside-avoid">
          <OptimizedPicture
            name="jobs/painless-van-london-shard"
            pattern="HALF"
            alt="Painless Removals van on a long-distance move in London by the Shard"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       APPLICATION FORM (open applications welcome)
  ============================================ -->
  <ApplicationForm roles={roles} source="jobs-page" />

  <!-- ============================================
       COMPANY VALUES
  ============================================ -->
  <section class="section bg-primary-600 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-10 left-10 w-40 h-40 border border-white rounded-full"></div>
      <div class="absolute bottom-10 right-10 w-60 h-60 border border-white rounded-full"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 border border-white rounded-full"></div>
    </div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-12">
        <h2 class="text-white text-3xl lg:text-4xl font-bold mb-4">What We Stand For</h2>
        <p class="text-primary-100 text-lg max-w-2xl mx-auto">
          These aren't just words on a wall. They're how we work, every single day.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        {values.map((value) => (
          <div class="stat-card-blue group text-center">
            <h3 class="text-xl font-bold text-white mb-2">{value.title}</h3>
            <p class="text-sm text-primary-200 group-hover:text-white transition-colors duration-300 leading-relaxed">{value.description}</p>
            <div class="w-0 h-0.5 bg-white/40 mx-auto mt-4 group-hover:w-12 transition-all duration-500"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       FINAL CTA
  ============================================ -->
  <section class="py-16 md:py-20 bg-cream text-center">
    <div class="container-wide">
      <h2 class="mb-4">Got Questions About Working With Us?</h2>
      <p class="text-warm-gray text-lg mb-8 max-w-xl mx-auto">
        Give Jay a call. He's always happy to chat about what it's like to work at Painless Removals.
      </p>

      <a href={`tel:${siteConfig.company.contact.phone.replace(/\s/g, '')}`}
        class="btn-cta-orange inline-flex items-center gap-3 no-underline duration-300 hover:shadow-orange-600/40 hover:text-white/90">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        Call {siteConfig.company.contact.phone}
      </a>
    </div>
  </section>

</Layout>
