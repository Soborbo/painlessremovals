---
/**
 * Complaints Page
 *
 * A private channel for an unhappy customer to reach us directly. The form
 * emails hello@ and mirrors into the CRM (24h first-response SLA, admins
 * notified) — see `api/complaint.ts`.
 *
 * Deliberately NOT tracked: a complaint is not a lead, and pushing it into the
 * dataLayer would count an unhappy customer as a conversion. No `noindex`
 * either — people should be able to find this page instead of writing a public
 * one-star review.
 */

import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config/site.config';
import { breadcrumbs } from '@/utils/schema';

const pageTitle = 'Complaints – Tell Us What Went Wrong';
const pageDescription = `Something not right with your move? Tell Painless Removals directly and we will respond within 24 hours. Call ${siteConfig.company.contact.phone} or use the form.`;

const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const schema = breadcrumbs([
  { name: 'Home', path: '/' },
  { name: 'Complaints', path: '/complaints/' },
]);
---

<Layout title={pageTitle} description={pageDescription} schema={schema}>
  <section class="bg-primary-700 text-white py-12 md:py-16">
    <div class="container-wide text-center">
      <h1 class="text-3xl md:text-4xl font-bold font-heading mb-3">Tell us what went wrong</h1>
      <p class="text-lg text-gray-100 max-w-2xl mx-auto">
        We would much rather hear it from you than read it later. Every complaint goes
        straight to the team, and we aim to come back to you within 24 hours.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-gray-50">
    <div class="container-wide max-w-3xl">
      <div class="bg-white rounded-2xl shadow-2xl p-6 sm:p-8 md:p-10">
        <form id="complaint-form-el" class="space-y-5" novalidate>
          <!-- Honeypot – hidden from humans, bots fill it -->
          <div style="position: absolute; left: -9999px;" aria-hidden="true">
            <label for="website">Leave this blank</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div>
            <label for="name" class="block text-sm font-semibold text-primary-600 mb-1.5">Your Name <span class="text-secondary-500">*</span></label>
            <input type="text" id="name" name="name" required autocomplete="name" maxlength="120"
              class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors" />
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="email" class="block text-sm font-semibold text-primary-600 mb-1.5">Email Address</label>
              <input type="email" id="email" name="email" autocomplete="email" maxlength="200"
                class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-primary-600 mb-1.5">Phone Number</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" maxlength="40"
                class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors" />
            </div>
          </div>
          <p class="text-warm-gray text-sm -mt-2">Please leave at least one of the two, so we can come back to you.</p>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="invoiceNumber" class="block text-sm font-semibold text-primary-600 mb-1.5">Invoice Number <span class="font-normal text-warm-gray">(if you have it)</span></label>
              <input type="text" id="invoiceNumber" name="invoiceNumber" maxlength="40" placeholder="e.g. INV-2026-0123" autocomplete="off"
                class="w-full px-4 py-3 text-base border border-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors" />
            </div>
            <div>
              <label for="occurredOn" class="block text-sm font-semibold text-primary-600 mb-1.5">When did the problem occur? <span class="text-secondary-500">*</span></label>
              <!-- text-base (16px): iOS kulonben RANAGYIT a mezore fokuszkor. A natív dátum-
                   mező mobilon sajat valasztot nyit; asztali gepen a showPicker() teszi, hogy
                   a mezo BARMELY pontjara kattintva feljojjon a naptar, ne csak az ikonra. -->
              <input type="date" id="occurredOn" name="occurredOn" required
                class="w-full px-4 py-3 text-base border border-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors" />
            </div>
          </div>

          <fieldset id="type-block" class="hidden">
            <legend class="block text-sm font-semibold text-primary-600 mb-2">What is this about? <span class="text-secondary-500">*</span></legend>
            <!-- Kartyak, nem legordulo: ket-harom lehetosegnel a valasztek legyen LATHATO,
                 ne egy kattintas mogott. A radio-input vegzi a munkat (billentyuzet, olvaso),
                 a kartya csak a megjelenese. -->
            <div id="type-options" class="grid gap-3 sm:grid-cols-2"></div>
          </fieldset>

          <!-- A valasztott tipus extra mezoi ide kerulnek (a CRM packjebol). -->
          <div id="type-fields" class="space-y-5"></div>



          <div>
            <label for="description" class="block text-sm font-semibold text-primary-600 mb-1.5">What happened? <span class="text-secondary-500">*</span></label>
            <textarea id="description" name="description" rows="6" required maxlength="4000"
              placeholder="Tell us what went wrong, when it happened, and what you would like us to do about it."
              class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors resize-y"></textarea>
          </div>

          <div>
            <label for="photos" class="block text-sm font-semibold text-primary-600 mb-1.5">
              Photos <span class="font-normal text-warm-gray">(up to 12)</span>
            </label>
            <input type="file" id="photos" name="photos" accept="image/*" multiple
              class="w-full px-4 py-3 border border-gray-200 rounded-lg file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-primary-50 file:text-primary-700 file:font-semibold hover:file:bg-primary-100" />
            <p id="photos-note" class="text-warm-gray text-sm mt-2">
              Photos of the damage help us assess a claim much faster. Up to 12 images, 10 MB each.
            </p>
          </div>

          <div>
            <label for="receipts" class="block text-sm font-semibold text-primary-600 mb-1.5">
              Receipts <span class="font-normal text-warm-gray">(proof of purchase, up to 12)</span>
            </label>
            <!-- Kulon feltolto a bizonylatoknak: mas a szerepuk a karrendezesben, mint a
                 kar-fotoknak, es a bizonylat tipikusan PDF-szkennelés — ezert itt a PDF is
                 elfogadott, mig a kar-fotok mindig kepek. -->
            <input type="file" id="receipts" name="receipts" accept="image/*,application/pdf" multiple
              class="w-full px-4 py-3 text-base border border-gray-200 rounded-lg file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-primary-50 file:text-primary-700 file:font-semibold hover:file:bg-primary-100" />
            <p class="text-warm-gray text-sm mt-2">
              A receipt or invoice for the item, as a photo or PDF scan. Claims with proof of
              purchase are assessed faster.
            </p>
          </div>

          <div>
            <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light" data-language="en"></div>
          </div>

          <div id="complaint-error" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"></div>

          <div>
            <button type="submit" id="complaint-submit-btn" class="btn-cta-orange cursor-pointer w-full sm:w-auto">
              SEND COMPLAINT
            </button>
            <p class="text-warm-gray text-sm mt-3">
              Prefer to talk? Call <span data-contact="phone-inline"><noscript>0117 287 0082</noscript></span>
            </p>
          </div>
        </form>

        <div id="complaint-success" class="hidden py-6">
          <div class="text-center">
            <h2 class="text-2xl font-bold font-heading text-primary-700 mb-2">Thank you — we have it.</h2>
            <p class="text-gray-700">
              Your complaint has been logged and someone will be in touch within 24 hours.
            </p>
          </div>

          <!-- Csak akkor latszik, ha a bejelentes a T&C 7 napos ablakan kivul erkezett.
               A hangnem SZANDEKOSAN nagyon udvarias: aki ide ir, mar mergessen — egy szaraz
               "lekeste a hataridot" ebbol nyilvanos egycsillagost csinal. Nem utasitunk el
               semmit, csak eloreveteljuk, mit jelenthet ez, hogy ne erje meglepetes. -->
          <div id="late-notice" class="hidden mt-8 bg-amber-50 border border-amber-200 rounded-xl p-6 text-left">
            <h3 class="text-lg font-bold font-heading text-amber-900 mb-2">One thing to mention</h3>
            <p class="text-amber-900 text-sm leading-relaxed">
              Our Terms &amp; Conditions ask for damage or loss to be reported within seven days
              of the move, and it looks like a little more time has passed than that. We would
              still much rather hear from you than not, so your report is with the team and we
              will look at it properly. We only wanted to flag it now, rather than surprise you
              later: where a claim falls outside that window we may have less room to put things
              right, particularly if our insurers need to be involved. If there was a reason the
              delay could not be helped, do tell us — we will take it into account.
            </p>
          </div>

          <div class="mt-8 bg-gray-50 border border-gray-200 rounded-xl p-6 text-left">
            <h3 class="text-lg font-bold font-heading text-primary-700 mb-2">What happens next</h3>
            <p class="text-gray-700 text-sm leading-relaxed">
              We aim to acknowledge your complaint within 24 hours and to come back to you with a
              response as quickly as we can. We may contact you for more detail, or to arrange an
              inspection, before we agree how to put things right. Where a complaint involves damage
              or loss, it is assessed against our Terms &amp; Conditions and, where necessary,
              referred to our insurers — so submitting this form does not by itself guarantee
              compensation.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Cloudflare Turnstile script -->
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script is:inline>
    (function () {
      // Email & phone scraping defence — azonos a contact.astro-eval.
      var ph = ['0','1','1','7',' ','2','8','7',' ','0','0','8','2'];
      var phClean = ph.join('').replace(/\s/g, '');
      var phDisplay = ph.join('');
      document.querySelectorAll('[data-contact="phone-inline"]').forEach(function (el) {
        el.innerHTML = '<a href="tel:' + phClean + '" class="font-semibold">' + phDisplay + '</a>';
      });

      var form = document.getElementById('complaint-form-el');
      if (!form) return;

      // Asztali bongeszoben a datum-mezo csak az ikonra kattintva nyilik; a showPicker()
      // teszi, hogy a mezo barmely pontja mukodjon. Mobilon a natív valaszto amugy is jon,
      // es a duplan hivott showPicker() ott csendben eldobodik (ezert a try/catch).
      var dateEl = document.getElementById('occurredOn');
      if (dateEl && typeof dateEl.showPicker === 'function') {
        dateEl.addEventListener('focus', function () { try { dateEl.showPicker(); } catch (e) {} });
        dateEl.addEventListener('click', function () { try { dateEl.showPicker(); } catch (e) {} });
      }

      var CARD_BASE = 'block cursor-pointer rounded-lg border p-4 transition-colors focus-within:ring-2 focus-within:ring-primary-500 ';
      var CARD_ON = 'border-primary-500 bg-primary-50';
      var CARD_OFF = 'border-gray-200 bg-white hover:border-primary-300';

      // ---- Panasz-tipusok a CRM-bol ----------------------------------------
      // Egyetlen forras: a tipusok es a mezoik a CRM packjeben elnek (per kliens config).
      // Ha a lekeres barmiert nem sikerul, a valaszto REJTVE marad es az urlap ugyanugy
      // bekuldheto — a bejelentes soha nem bukhat el azon, hogy a lista nem toltodott be.
      var TYPES = [];
      var typeBlock = document.getElementById('type-block');
      var typeOptions = document.getElementById('type-options');
      var typeFields = document.getElementById('type-fields');

      function selectedType() {
        var el = typeOptions ? typeOptions.querySelector('input[name="complaintType"]:checked') : null;
        return el ? el.value : '';
      }

      function fieldHtml(f) {
        var id = 'tf_' + f.key;
        var req = f.required ? ' required' : '';
        var star = f.required ? ' <span class="text-secondary-500">*</span>' : '';
        var cls = 'w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors';
        var label = '<label for="' + id + '" class="block text-sm font-semibold text-primary-600 mb-1.5">' + f.label + star + '</label>';
        var input;
        if (f.type === 'textarea') {
          input = '<textarea id="' + id + '" rows="4" class="' + cls + ' resize-y"' + req + '></textarea>';
        } else if (f.type === 'bool') {
          return '<label class="flex items-center gap-2 text-gray-700"><input type="checkbox" id="' + id + '" /> ' + f.label + '</label>';
        } else if (f.type === 'select') {
          var opts = (f.options || []).map(function (o) { return '<option value="' + o.value + '">' + o.label + '</option>'; }).join('');
          input = '<select id="' + id + '" class="' + cls + ' bg-white"' + req + '><option value="">—</option>' + opts + '</select>';
        } else if (f.type === 'date') {
          input = '<input type="date" id="' + id + '" class="' + cls + '"' + req + ' />';
        } else if (f.type === 'money' || f.type === 'number') {
          var unit = f.unit ? ' <span class="font-normal text-warm-gray">(' + f.unit + ')</span>' : '';
          label = '<label for="' + id + '" class="block text-sm font-semibold text-primary-600 mb-1.5">' + f.label + unit + star + '</label>';
          input = '<input type="number" inputmode="decimal" step="' + (f.type === 'money' ? '0.01' : '1') + '" id="' + id + '" class="' + cls + '"' + req + ' />';
        } else {
          input = '<input type="text" id="' + id + '" class="' + cls + '"' + req + ' />';
        }
        return '<div>' + label + input + '</div>';
      }

      function renderType() {
        var key = selectedType();
        var t = TYPES.filter(function (x) { return x.key === key; })[0];
        typeFields.innerHTML = t ? t.fields.map(fieldHtml).join('') : '';
        // A kivalasztott kartya lathatoan is kiemelkedjen (a radio maga rejtve van).
        Array.prototype.forEach.call(typeOptions.querySelectorAll('[data-type-card]'), function (card) {
          var on = card.getAttribute('data-type-card') === key;
          card.className = CARD_BASE + (on ? CARD_ON : CARD_OFF);
        });
      }

      function collectAnswers() {
        var t = TYPES.filter(function (x) { return x.key === selectedType(); })[0];
        if (!t) return {};
        var out = {};
        t.fields.forEach(function (f) {
          var el = document.getElementById('tf_' + f.key);
          if (!el) return;
          if (f.type === 'bool') { out[f.key] = el.checked; return; }
          var v = el.value;
          if (v === '' || v == null) return;
          // A `money` egesz minor unitban megy (penny) — a float penz tilos.
          if (f.type === 'money') { out[f.key] = Math.round(parseFloat(v) * 100); return; }
          if (f.type === 'number') { out[f.key] = Number(v); return; }
          out[f.key] = v;
        });
        return out;
      }

      fetch('https://crm.painlessremovals.com/api/public/complaint-types')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.types || d.types.length < 2) return; // egyetlen tipusnal a valaszto csak zaj
          TYPES = d.types;
          typeOptions.innerHTML = TYPES.map(function (t, i) {
            return (
              '<label data-type-card="' + t.key + '" class="' + CARD_BASE + (i === 0 ? CARD_ON : CARD_OFF) + '">' +
                '<input type="radio" name="complaintType" value="' + t.key + '" class="sr-only"' + (i === 0 ? ' checked' : '') + ' />' +
                '<span class="block font-semibold text-primary-700">' + t.label + '</span>' +
                '<span class="block text-sm text-warm-gray mt-1">' + t.hint + '</span>' +
              '</label>'
            );
          }).join('');
          typeBlock.classList.remove('hidden');
          typeOptions.addEventListener('change', renderType);
          renderType();
        })
        .catch(function () { /* a valaszto rejtve marad; az urlap mukodik */ });
      // ----------------------------------------------------------------------
      var errorBox = document.getElementById('complaint-error');
      var successBox = document.getElementById('complaint-success');
      var btn = document.getElementById('complaint-submit-btn');

      function showError(msg) {
        errorBox.textContent = msg;
        errorBox.classList.remove('hidden');
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        errorBox.classList.add('hidden');

        var name = form.querySelector('#name').value.trim();
        var email = form.querySelector('#email').value.trim();
        var phone = form.querySelector('#phone').value.trim();
        var invoiceNumber = form.querySelector('#invoiceNumber').value.trim();
        var occurredOn = form.querySelector('#occurredOn').value;
        var description = form.querySelector('#description').value.trim();
        var honeypot = form.querySelector('#website').value;

        if (!name || description.length < 10) {
          showError('Please tell us your name and describe what happened.');
          return;
        }
        if (!email && !phone) {
          showError('Please leave an email address or a phone number so we can reply.');
          return;
        }
        if (!occurredOn) {
          showError('Please tell us when the problem occurred.');
          return;
        }

        var turnstileResponse = '';
        var turnstileInput = form.querySelector('[name="cf-turnstile-response"]');
        if (turnstileInput) turnstileResponse = turnstileInput.value;
        if (!turnstileResponse) {
          showError('Please complete the security check and try again.');
          return;
        }

        // Kliensoldali kapu: a szerver ugyanezt ujra ellenorzi (a bongeszonek sosem hiszunk),
        // de itt azonnal, halozati kor nelkul tudjuk megmondani, hogy tul sok vagy tul nagy.
        function filesOf(id) {
          var el = form.querySelector(id);
          return el && el.files ? Array.prototype.slice.call(el.files) : [];
        }
        var photos = filesOf('#photos');
        var receipts = filesOf('#receipts');
        if (photos.length > 12 || receipts.length > 12) {
          showError('Please attach at most 12 photos and 12 receipts.');
          return;
        }
        var tooBig = photos.concat(receipts).filter(function (f) { return f.size > 10 * 1024 * 1024; })[0];
        if (tooBig) {
          showError('Each file must be under 10 MB. "' + tooBig.name + '" is too large.');
          return;
        }

        btn.disabled = true;
        var original = btn.textContent;
        btn.textContent = photos.length + receipts.length > 0 ? 'UPLOADING...' : 'SENDING...';

        var payload = {
          type: TYPES.length > 0 ? (selectedType() || null) : null,
          answers: collectAnswers(),
          name: name,
          email: email || null,
          phone: phone || null,
          jobNumber: invoiceNumber || null,
          occurredOn: occurredOn || null,
          description: description,
          honeypot: honeypot,
          turnstileToken: turnstileResponse
        };

        var init;
        if (photos.length + receipts.length > 0) {
          var fd = new FormData();
          Object.keys(payload).forEach(function (k) {
            if (payload[k] === null || payload[k] === undefined) return;
            fd.set(k, k === 'answers' ? JSON.stringify(payload[k]) : payload[k]);
          });
          photos.forEach(function (f) { fd.append('photos', f); });
          receipts.forEach(function (f) { fd.append('receipts', f); });
          // Content-Type-ot SZANDEKOSAN nem allitunk: a bongeszo teszi ra a boundary-t.
          init = { method: 'POST', body: fd };
        } else {
          init = {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          };
        }

        fetch('/api/complaint', init)
          .then(function (res) {
            return res.json().then(function (data) { return { ok: res.ok, data: data }; });
          })
          .then(function (r) {
            if (r.ok && r.data && r.data.success) {
              form.classList.add('hidden');
              // A szerver mondja meg, hogy a 7 napos ablakon kivul vagyunk-e — nem itt
              // szamoljuk, kulonben a ket oldal szabalya elcsuszhatna.
              if (r.data.late) {
                var late = document.getElementById('late-notice');
                if (late) late.classList.remove('hidden');
              }
              successBox.classList.remove('hidden');
              return;
            }
            showError((r.data && r.data.error) || 'Something went wrong. Please try again.');
            btn.disabled = false;
            btn.textContent = original;
            if (window.turnstile) window.turnstile.reset();
          })
          .catch(function () {
            showError('Network error. Please check your connection and try again.');
            btn.disabled = false;
            btn.textContent = original;
            if (window.turnstile) window.turnstile.reset();
          });
      });
    })();
  </script>
</Layout>
